<UserControl x:Class="DriveRedirect.Desktop.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,4,0,20">
            <StackPanel>
                <TextBlock Text="路径规则" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="默认映射、应用白/黑名单与系统保护目录。" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox Width="138" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label" Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddRuleCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,7,0" />
                        <TextBlock Text="添加规则" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="13,8" Margin="0,0,0,12"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="8,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="10,8,10,6">
                    <TextBlock Text="{Binding RuleCountText}" Style="{StaticResource SubtleText}" />
                    <TextBlock Text="最长源路径优先 · 启用状态实时生效" Style="{StaticResource SubtleText}" HorizontalAlignment="Right" />
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" RowHeight="56">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="规则" Width="1.6*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource PillBorder}" Padding="6,2" Margin="8,0,0,0"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="内置" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note, TargetNullValue=—}" Style="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="类型" Width="92">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Kind, Converter={StaticResource RuleKindToText}}" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="源路径 / 匹配" Width="1.4*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SourcePattern}" FontFamily="Consolas, Cascadia Mono" FontSize="11"
                                               ToolTip="{Binding SourcePattern}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="目标路径" Width="1.4*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TargetPattern, TargetNullValue=—}" FontFamily="Consolas, Cascadia Mono" FontSize="11"
                                               ToolTip="{Binding TargetPattern}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="AppData" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="—" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AllowAppData}" Value="True">
                                                        <Setter Property="Text" Value="允许" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="启用" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                                            Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsBuiltIn, Converter={StaticResource InverseBool}}"
                                            ToolTip="删除规则">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" FontSize="13" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="此分类下暂无规则" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="使用右上角“添加规则”创建自定义映射或名单。" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SoftCardBorder}" Margin="0,12,0,0" Padding="16,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,18,0">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource WarningSoftBrush}">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="系统保护目录" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock Text="始终禁止重定向" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding ProtectedPaths}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PillBorder}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,7,7">
                                <TextBlock Text="{Binding}" FontFamily="Consolas, Cascadia Mono" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
