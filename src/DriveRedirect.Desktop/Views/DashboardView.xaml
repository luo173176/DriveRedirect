<UserControl x:Class="DriveRedirect.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1220" HorizontalAlignment="Left">
            <Grid Margin="0,4,0,22">
                <StackPanel>
                    <TextBlock Text="概览" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="安装习惯不变，默认路径自动落到 D 盘。" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PillBorder}"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MonitoringActive}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="监控未运行" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MonitoringActive}" Value="True">
                                            <Setter Property="Text" Value="后台监控运行中" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Background="{DynamicResource HeroGradientBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="28,25" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource PillBorder}" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="默认安装自动重定向" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="点击下一步，也可以让空间留在 D 盘" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="24" FontWeight="SemiBold" Margin="0,14,0,0" />
                        <TextBlock Text="通过安装器官方参数在文件写入前设置目录。支持 MSI、Inno Setup、NSIS、WiX，InstallShield 与自定义 EXE 按验证级别处理。"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap"
                                   MaxWidth="620" HorizontalAlignment="Left" Margin="0,9,0,0" LineHeight="20" />

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding AutomaticRedirectEnabled, Mode=OneWay}"
                                          Command="{Binding ToggleAutoRedirectCommand}"
                                          VerticalAlignment="Center" />
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="自动重定向" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Style="{StaticResource SubtleText}" Margin="0,2,0,0">
                                    <Run Text="当前状态：" />
                                    <Run Text="{Binding AutomaticRedirectEnabled, Converter={StaticResource BoolToOnOff}, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="20" Margin="28,0,0,0"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="当前保护链" Style="{StaticResource CardTitleText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource SuccessSoftBrush}">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource SuccessBrush}" FontSize="14" />
                                </Border>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ShellIntegrationText}" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="EXE / MSI 双击接管" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,13" />
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource AccentBrush}" FontSize="14" />
                                </Border>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="安装进程监控" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="WMI 事件 + 轮询后备" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="10" Padding="14,9" Margin="0,0,0,18"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE7C3;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="今日安装" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding TodayInstalls}" Style="{StaticResource StatValueText}" Margin="0,13,0,0" />
                        <TextBlock Text="由后台监控记录的安装器启动" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SuccessSoftBrush}">
                                <TextBlock Text="&#xE8AB;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                            <TextBlock Text="今日重定向" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding TodayRedirects}" Style="{StaticResource StatValueText}" Margin="0,13,0,0" />
                        <TextBlock Text="已确认实际落入 D 盘" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="12,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource WarningSoftBrush}">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                            <TextBlock Text="累计重定向" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalRedirects}" Style="{StaticResource StatValueText}" Margin="0,13,0,0" />
                        <TextBlock Text="仅统计验证成功的安装" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,9,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="系统盘 · C:" Style="{StaticResource CardTitleText}" />
                                <TextBlock Text="{Binding SystemTotalText}" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SystemFreeText}" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="可用空间" Style="{StaticResource SubtleText}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{Binding SystemUsagePercent, Mode=OneWay}" Maximum="100" Margin="0,18,0,8" />
                        <TextBlock Text="{Binding SystemUsageText}" Style="{StaticResource SubtleText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="9,0,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="目标盘 · D:" Style="{StaticResource CardTitleText}" />
                                <TextBlock Text="{Binding TargetTotalText}" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TargetFreeText}" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Text="可用空间" Style="{StaticResource SubtleText}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{Binding TargetUsagePercent, Mode=OneWay}" Maximum="100" Margin="0,18,0,8" Foreground="{DynamicResource SuccessBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TargetUsageText}" Style="{StaticResource SubtleText}" />
                            <TextBlock Text=" · 固定目标磁盘" Style="{StaticResource SubtleText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Padding="20,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="最近安装" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="只显示最近的安装结果，完整记录可在安装记录页查看。" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenLogFolderCommand}" ToolTip="打开日志目录">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="日志" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RecentInstallations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="106" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,16,0">
                                        <TextBlock Text="{Binding SoftwareName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding InstallerType, Converter={StaticResource InstallerTypeToText}, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ActualPath, Mode=OneWay, TargetNullValue=未验证路径}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource PillBorder}" Background="{Binding Status, Converter={StaticResource StatusToSoftBrush}}"
                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="5" Height="5" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding StartedAt, Converter={StaticResource DateToText}}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" Margin="0,22">
                        <TextBlock Text="还没有安装记录" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="启动一个安装包，DriveRedirect 会在这里展示识别和重定向结果。" Style="{StaticResource SubtleText}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
