<UserControl x:Class="DriveRedirect.Desktop.Views.CompatibilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,4,0,22">
                <StackPanel>
                    <TextBlock Text="兼容性中心" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="适配器能力、真实验证状态与已识别安装器。" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Background="{DynamicResource HeroGradientBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="26,22" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource PillBorder}" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="适配策略" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="只对可靠支持路径改写的安装器自动处理" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="22" FontWeight="SemiBold" Margin="0,13,0,0" />
                        <TextBlock Text="MSI 使用 Windows Installer 公共属性或 MST；Inno Setup 使用 /DIR；NSIS 使用 /D=；InstallShield 仅在 Basic MSI 模式下使用 MSI 属性。无法可靠判断时进入辅助模式或安全放行。"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap"
                                   MaxWidth="760" HorizontalAlignment="Left" Margin="0,8,0,0" LineHeight="20" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18,14"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="24,0,0,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="已验证能力" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="自动重定向" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="不终止安装器 · 不注入进程" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="安装器适配器" Style="{StaticResource SectionTitleText}" Margin="0,2,0,10" />
            <ItemsControl ItemsSource="{Binding Adapters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="18,16">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitleText}" />
                                            <Border Style="{StaticResource PillBorder}" Background="{Binding Compatibility, Converter={StaticResource CompatibilityToBrush}}"
                                                    Opacity="0.12" Margin="9,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0">
                                            <Run Text="v" />
                                            <Run Text="{Binding AdapterVersion, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding InstallerType, Converter={StaticResource InstallerTypeToText}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Border Style="{StaticResource PillBorder}" Background="{DynamicResource SurfaceMutedBrush}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Compatibility, Converter={StaticResource CompatibilityToText}}"
                                                       Foreground="{Binding Compatibility, Converter={StaticResource CompatibilityToBrush}}"
                                                       FontSize="10.5" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Style="{StaticResource PillBorder}" Background="{DynamicResource SurfaceMutedBrush}">
                                            <TextBlock Text="{Binding TestStatus, Converter={StaticResource TestStatusToText}}" FontSize="10.5" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource Divider}" Margin="0,12" />
                                <TextBlock Text="适配方式" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding Strategy}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18" />
                                <TextBlock Text="{Binding TestSummary}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="17" />
                                <TextBlock Text="{Binding Limitation}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource WarningBrush}" LineHeight="17"
                                           Visibility="{Binding Limitation, Converter={StaticResource NullToVisibility}}" />

                                <Grid Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource SubtleText}">
                                        <Run Text="已观察 " />
                                        <Run Text="{Binding ObservedCount, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" 次" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource SubtleText}" HorizontalAlignment="Right"
                                               Text="{Binding LastObservedAt, Converter={StaticResource DateToText}, TargetNullValue=尚未观察}"
                                               Visibility="{Binding LastObservedAt, Converter={StaticResource NullToVisibility}}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CardBorder}" Margin="0,6,0,0" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="已识别的安装器" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="来自后台进程监控与启动拦截的实际样本；模式与原因反映当时的安全决策。"
                               Style="{StaticResource SubtleText}" Margin="0,4,0,12" />

                    <Border Style="{StaticResource SoftCardBorder}" Visibility="{Binding HasObservations, Converter={StaticResource BoolToVisibility}}"
                            Padding="0" Background="Transparent">
                        <ItemsControl ItemsSource="{Binding ObservedInstallers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="11" Padding="14,11" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="96" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE7B8;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SoftwareName, TargetNullValue=未知软件}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource SubtleText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding InstallerType, Converter={StaticResource InstallerTypeToText}, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding InstallerPath, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Border Style="{StaticResource PillBorder}" Background="{Binding Compatibility, Converter={StaticResource CompatibilityToBrush}}" Opacity="0.12" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Compatibility, Converter={StaticResource CompatibilityToText}}" FontSize="10.5" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Style="{StaticResource PillBorder}" Background="{DynamicResource SurfaceBrush}">
                                                    <TextBlock Text="{Binding Mode, Converter={StaticResource ModeToText}}" FontSize="10.5" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding DetectedAt, Converter={StaticResource DateToText}}"
                                                       Style="{StaticResource SubtleText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Visibility="{Binding HasNoObservations, Converter={StaticResource BoolToVisibility}}" Margin="0,22">
                        <TextBlock Text="还没有识别记录" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="运行一次安装包后，安装器识别结果会出现在这里。" Style="{StaticResource SubtleText}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
