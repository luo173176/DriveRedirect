<UserControl x:Class="DriveRedirect.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,4,0,20">
            <StackPanel>
                <TextBlock Text="安装记录" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="可搜索、筛选和排序的完整安装审计记录。" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="导出 CSV" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DangerButtonStyle}" Command="{Binding ClearHistoryCommand}">
                    <TextBlock Text="清除记录" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchBox_OnKeyDown"
                                 ToolTip="搜索软件名称、路径或安装器文件" />
                        <TextBlock Text="搜索软件名称、路径或安装器文件"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibility}}" />
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,7,0" />
                            <TextBlock Text="搜索" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding ResultFilters}" SelectedItem="{Binding SelectedResultFilter}" DisplayMemberPath="Label" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding InstallerFilters}" SelectedItem="{Binding SelectedInstallerFilter}" DisplayMemberPath="Label" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Label" Margin="0,0,14,0" />
                    <CheckBox Grid.Column="3" Content="最新优先" IsChecked="{Binding SortDescending}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="13,8" Margin="0,0,0,12"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="8,4,8,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="10,8,10,6">
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource SubtleText}" />
                    <TextBlock Text="后台每 3 秒自动刷新当前页面" Style="{StaticResource SubtleText}" HorizontalAlignment="Right" />
                </Grid>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedRecord}"
                          ScrollViewer.CanContentScroll="True"
                          SelectionChanged="HistoryGrid_OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="软件" Width="*" MinWidth="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SoftwareName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource SubtleText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding InstallerType, Converter={StaticResource InstallerTypeToText}, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Mode, Converter={StaticResource ModeToText}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="时间" Width="118">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartedAt, Converter={StaticResource DateToText}}" Style="{StaticResource SubtleText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="原始路径" Width="1.1*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OriginalPath, TargetNullValue=未知}" ToolTip="{Binding OriginalPath}"
                                               FontFamily="Consolas, Cascadia Mono" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="实际路径" Width="1.1*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ActualPath, TargetNullValue=未验证}" ToolTip="{Binding ActualPath}"
                                               FontFamily="Consolas, Cascadia Mono" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="结果" Width="106">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PillBorder}" Background="{Binding Status, Converter={StaticResource StatusToSoftBrush}}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="没有匹配的安装记录" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="修改搜索或筛选条件再试一次。" Style="{StaticResource SubtleText}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,12,0,0"
                Visibility="{Binding HasSelectedRecord, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedRecord.SoftwareName}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0">
                        <Run Text="{Binding SelectedRecord.StartedAt, Converter={StaticResource LongDateToText}, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding SelectedRecord.InstallerType, Converter={StaticResource InstallerTypeToText}, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0">
                    <TextBlock Text="原始 → 目标" Style="{StaticResource SubtleText}" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding SelectedRecord.OriginalPath, Mode=OneWay}" />
                        <Run Text="  →  " Foreground="{DynamicResource TextTertiaryBrush}" />
                        <Run Text="{Binding SelectedRecord.TargetPath, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="策略 / 失败原因" Style="{StaticResource SubtleText}" />
                    <TextBlock Text="{Binding SelectedRecord.FailureReason, TargetNullValue=无失败记录}" Style="{StaticResource SubtleText}"
                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedRecord.FailureReason}" />
                    <TextBlock Text="{Binding SelectedRecord.Strategy}" Style="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="3" Style="{StaticResource PillBorder}" Background="{Binding SelectedRecord.Status, Converter={StaticResource StatusToSoftBrush}}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedRecord.Status, Converter={StaticResource StatusToText}}" Foreground="{Binding SelectedRecord.Status, Converter={StaticResource StatusToBrush}}" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
