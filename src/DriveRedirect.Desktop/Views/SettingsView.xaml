<UserControl x:Class="DriveRedirect.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
            <Grid Margin="0,4,0,22">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="控制后台监控、启动接管、日志与数据维护。" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,7,0" />
                        <TextBlock Text="保存设置" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasLastError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="最近一次后台异常" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="10" Padding="14,9" Margin="0,0,0,16"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,9,0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="重定向与监控" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="核心开关。关闭自动重定向后，安装器将按原始设置运行。"
                                       Style="{StaticResource SubtleText}" Margin="0,4,0,14" />

                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="自动重定向" FontWeight="SemiBold" />
                                    <TextBlock Text="在可靠支持时自动把 C 盘路径改写为 D 盘。" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding AutomaticRedirect}" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="后台监控" FontWeight="SemiBold" />
                                    <TextBlock Text="使用 WMI 进程事件与轮询发现安装器启动；更改后需重启服务。" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding BackgroundMonitoring}" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="开机启动" FontWeight="SemiBold" />
                                    <TextBlock Text="将后台服务设置为自动启动。" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding StartWithWindows}" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="安装后验证" FontWeight="SemiBold" />
                                    <TextBlock Text="等待进程结束并核对文件系统与卸载注册表，防止虚报成功。" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding VerifyAfterInstall}" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="MSI MST 回退" FontWeight="SemiBold" />
                                    <TextBlock Text="无公共安装目录属性时生成临时 MST 改写 Directory 表。" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding EnableMsiTransformFallback}" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="AppData 应用级重定向" FontWeight="SemiBold" />
                                    <TextBlock Text="仅为白名单中明确授权的应用启用，不迁移整个 AppData。"
                                               Style="{StaticResource SubtleText}" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="390" />
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding AllowAppDataRedirection}" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="通知" FontWeight="SemiBold" />
                                    <TextBlock Text="在桌面端提示安装完成与失败事件。" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding NotificationsEnabled}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="资源管理器启动接管" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="接管 EXE / MSI 文件关联，使双击安装包在写入文件前获得重定向计划。更改需要管理员权限，修改前会备份原关联。"
                                       Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,14" LineHeight="18" />
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="启用双击接管" FontWeight="SemiBold" />
                                    <TextBlock Text="关闭时将恢复为系统默认文件关联。" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding ExplorerIntegration}" />
                            </Grid>
                            <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,4,0,12">
                                <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                           Text="接管只覆盖通过 Explorer 文件关联启动的安装器。命令行、浏览器直接启动或更新器内部调用会绕过预启动改写，服务只能记录并安全放行。" />
                            </Border>
                            <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RestoreShellAssociationCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7A7;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,7,0" />
                                    <TextBlock Text="恢复原始启动关联" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="目标磁盘与规则" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="目标磁盘固定为 D:，以避免自动切换造成不可预期的软件分布。"
                                       Style="{StaticResource SubtleText}" Margin="0,4,0,14" TextWrapping="Wrap" />
                            <Border Style="{StaticResource SoftCardBorder}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="默认目标磁盘" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{Binding TargetDriveText}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Style="{StaticResource PillBorder}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="{DynamicResource SuccessSoftBrush}">
                                        <TextBlock Text="固定" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="最低剩余空间 (GB)" FontWeight="SemiBold" />
                                    <TextBlock Text="低于该值时停止自动重定向并提示。" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBox Width="92" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Text="{Binding MinimumFreeSpaceGb, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Text="路径映射、白名单和黑名单在「路径规则」页维护。"
                                       Style="{StaticResource SubtleText}" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="外观与日志" Style="{StaticResource SectionTitleText}" />
                            <Grid Margin="0,14,0,12">
                                <TextBlock Text="界面主题" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox Width="150" HorizontalAlignment="Right"
                                          ItemsSource="{Binding Themes}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedTheme}" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="日志级别" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox Width="150" HorizontalAlignment="Right"
                                          ItemsSource="{Binding LogLevels}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedLogLevel}" />
                            </Grid>
                            <TextBlock Text="日志级别在服务下次启动时生效。" Style="{StaticResource SubtleText}" Margin="0,0,0,12" />
                            <Border Style="{StaticResource Divider}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportLogsCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="导出日志" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenLogFolderCommand}">
                                    <TextBlock Text="打开日志目录" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="服务与数据" Style="{StaticResource SectionTitleText}" />
                            <Grid Margin="0,13,0,10">
                                <TextBlock Text="服务状态" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding ServiceStatus}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                            </Grid>
                            <TextBlock Text="{Binding DiagnosticsSummary}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RestartServiceCommand}" Margin="0,0,8,0">
                                    <TextBlock Text="重启服务" />
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BackupDatabaseCommand}" Margin="0,0,8,0">
                                    <TextBlock Text="备份数据库" />
                                </Button>
                                <Button Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenDataFolderCommand}">
                                    <TextBlock Text="打开数据目录" />
                                </Button>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,10,0,10" />
                            <Button HorizontalAlignment="Left" Style="{StaticResource DangerButtonStyle}" Command="{Binding ClearHistoryCommand}">
                                <TextBlock Text="清空安装历史" />
                            </Button>
                            <TextBlock Text="清空历史不会删除已安装软件、日志或规则。" Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="关于" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding AppVersion}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource SubtleText}" Margin="0,5,0,0" />
                            <TextBlock Text="安装路径自动重定向管理器 · 固定目标磁盘 D:" Style="{StaticResource SubtleText}" Margin="0,3,0,0" />
                            <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="9" Padding="11,8" Margin="0,12,0,0">
                                <TextBlock Text="{Binding DataDirectory}" FontFamily="Consolas, Cascadia Mono" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
