<UserControl x:Class="DriveRedirect.Desktop.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,4,0,22">
                <StackPanel>
                    <TextBlock Text="实时监控" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="安装器启动、识别与路径改写状态。" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SessionCountText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
                <Border Background="{DynamicResource HeroGradientBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="26" Margin="0,0,0,18">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <Border Style="{StaticResource PillBorder}" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="当前活动安装" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding CurrentSession.SoftwareName}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="27" FontWeight="SemiBold" Margin="0,14,0,0" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0">
                                    <Run Text="{Binding CurrentSession.InstallerType, Converter={StaticResource InstallerTypeToText}, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding CurrentSession.AdapterId, Mode=OneWay, TargetNullValue=进程监控}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding CurrentSession.Mode, Converter={StaticResource ModeToText}, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PillBorder}"
                                    Background="{Binding CurrentSession.Status, Converter={StaticResource StatusToSoftBrush}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{Binding CurrentSession.Status, Converter={StaticResource StatusToBrush}}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding CurrentSession.Status, Converter={StaticResource StatusToText}}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="原始默认路径" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding CurrentSession.OriginalPath, TargetNullValue=未能确定}" FontFamily="Consolas, Cascadia Mono"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="8,0,0,0"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="目标安装路径" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding CurrentSession.TargetPath, TargetNullValue=安全放行 / 辅助模式}" FontFamily="Consolas, Cascadia Mono"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock Text="PID" Style="{StaticResource SubtleText}" />
                                <TextBlock Text="{Binding CurrentSession.ProcessId, TargetNullValue=等待进程}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="开始时间" Style="{StaticResource SubtleText}" />
                                <TextBlock Text="{Binding CurrentSession.StartedAt, Converter={StaticResource LongDateToText}}" FontSize="12" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding CurrentSession.StatusDetail}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="全部活动会话" Style="{StaticResource SectionTitleText}" />
                        <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="12" Padding="15,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE7B8;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SoftwareName}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource SubtleText}" Margin="0,3,0,0">
                                                    <Run Text="{Binding InstallerType, Converter={StaticResource InstallerTypeToText}, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding TargetPath, TargetNullValue=无目标改写}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource PillBorder}" Background="{Binding Status, Converter={StaticResource StatusToSoftBrush}}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding StartedAt, Converter={StaticResource DateToText}}" Style="{StaticResource SubtleText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" Padding="32">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="70" Height="70" CornerRadius="22" Background="{DynamicResource SurfaceMutedBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource IconGlyph}" FontSize="29" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Border>
                    <TextBlock Text="当前没有正在安装的程序" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="安装器启动后，这里会显示安装器类型、默认路径、目标路径和自动重定向结果。"
                               Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,7,0,0" TextAlignment="Center" MaxWidth="500" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
