<Window x:Class="DriveRedirect.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DriveRedirect.Desktop.ViewModels"
        xmlns:views="clr-namespace:DriveRedirect.Desktop.Views"
        Title="DriveRedirect"
        Width="1120"
        Height="680"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="7"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LiveViewModel}">
            <views:LiveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}">
            <views:RulesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompatibilityViewModel}">
            <views:CompatibilityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource NavBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="22,20,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentGradientBrush}" VerticalAlignment="Top">
                        <TextBlock Text="D" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="21"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DriveRedirect" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="安装路径自动重定向" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1"
                         x:Name="NavList"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconGlyph}" FontSize="17" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="16,10,16,18">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13,11">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServiceOnline}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ServiceStatusText}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding ServiceStatusDetail}" Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="15,5,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding AppVersion}" Style="{StaticResource SubtleText}" Margin="4,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock Text="最近更新" Style="{StaticResource SubtleText}" />
                    <Border Width="5" Height="5" CornerRadius="3" Background="{DynamicResource BorderStrongBrush}" Margin="10,1,10,0" />
                    <TextBlock Text="{Binding ServiceStatusDetail}" Style="{StaticResource SubtleText}" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,6,0">
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="刷新当前页面"
                            Command="{Binding RefreshCurrentCommand}"
                            ToolTip="刷新当前页面"
                            Margin="0,0,4,0">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="15" />
                    </Button>
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="切换主题"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="{Binding ThemeToolTip}"
                            Margin="0,0,12,0">
                        <TextBlock Text="{Binding ThemeGlyph}" Style="{StaticResource IconGlyph}" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource WindowControlButton}" Click="Minimize_OnClick" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" Style="{StaticResource IconGlyph}" FontSize="11" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Click="Maximize_OnClick" ToolTip="最大化">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" Style="{StaticResource IconGlyph}" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource CloseWindowButton}" Click="Close_OnClick" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ContentControl x:Name="PageHost"
                                Content="{Binding CurrentPage}"
                                Margin="28,10,28,24"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" />

                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16,12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,28,28"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#33000000" BlurRadius="18" ShadowDepth="4" Opacity="0.55" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                        </Border>
                        <TextBlock Text="{Binding ToastMessage}" VerticalAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
