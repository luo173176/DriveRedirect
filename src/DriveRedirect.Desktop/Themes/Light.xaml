<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#F3F5FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
    <Color x:Key="SurfaceMutedColor">#F0F3F9</Color>
    <Color x:Key="NavBackgroundColor">#E9EEF7</Color>
    <Color x:Key="NavSelectedColor">#FFFFFF</Color>
    <Color x:Key="NavHoverColor">#DDE5F2</Color>
    <Color x:Key="BorderColor">#E1E7F0</Color>
    <Color x:Key="BorderStrongColor">#C9D3E2</Color>
    <Color x:Key="TextPrimaryColor">#172033</Color>
    <Color x:Key="TextSecondaryColor">#5B687D</Color>
    <Color x:Key="TextTertiaryColor">#8B96A9</Color>
    <Color x:Key="AccentColor">#4C6FFF</Color>
    <Color x:Key="AccentHoverColor">#3B5DE7</Color>
    <Color x:Key="AccentSoftColor">#E7EDFF</Color>
    <Color x:Key="SuccessColor">#159A6C</Color>
    <Color x:Key="SuccessSoftColor">#E5F7F0</Color>
    <Color x:Key="WarningColor">#C67B0B</Color>
    <Color x:Key="WarningSoftColor">#FFF2D9</Color>
    <Color x:Key="DangerColor">#D64545</Color>
    <Color x:Key="DangerSoftColor">#FDEDED</Color>
    <Color x:Key="InfoColor">#2F7DE1</Color>
    <Color x:Key="InputBackgroundColor">#F7F9FC</Color>
    <Color x:Key="WindowButtonHoverColor">#E8EDF6</Color>
    <Color x:Key="CloseHoverColor">#E81123</Color>
    <Color x:Key="OverlayColor">#66000000</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="{StaticResource NavBackgroundColor}" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="{StaticResource NavHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="{StaticResource WindowButtonHoverColor}" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E9EFFF" Offset="0" />
        <GradientStop Color="#F5F8FF" Offset="0.55" />
        <GradientStop Color="#EDF8F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5C7CFF" Offset="0" />
        <GradientStop Color="#3F63EF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
